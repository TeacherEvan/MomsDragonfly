# Copy to .env.local for LOCAL development only.
# NEVER commit .env.local (see .gitignore).
#
# Best practices:
# - NEXT_PUBLIC_* variables go in `.env.local` for local dev and in Vercel dashboard/project env for deployment.
# - Convex server-side secrets (GOOGLE_PLACES_API_KEY, etc.) are set via `convex env set`, NOT `.env.local`.
# - See `.env.setup.md` for exact CLI commands.

# ============================================================
# Public (browser-safe) — Vercel / Next.js local dev
# ============================================================
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# ============================================================
# Convex server-side secrets — set via CLI, NOT this file
# (Run: npx convex env set KEY value --env dev  OR  --env production)
# ============================================================
# GOOGLE_PLACES_API_KEY=AIza...
# BRAVE_SEARCH_API_KEY=BSA...       # optional
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash      # optional; used by convex/actions.ts
# VAPID_PUBLIC_KEY=...              # npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@example.com

# Optional / additional
# GEMINI_MODEL=gemini-1.5-flash
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<generate-via-npx-web-push-generate-vapid-keys>
